section.code
kernel_start:
    ipf 1200

    ;clear ecran et chargement du disque
    set i_GPU_color, i_CPU_BLACK
    gpu clear
    set i_GPU_x, #184
    set i_GPU_y, #220
    set i_GPU_s, #2
    psh s_loading_msg
    cal print_string
    slp 1000
    set i_GPU_color, i_CPU_BLACK
    gpu clear

    ;position d'affichage
    set i_GPU_color, i_CPU_WHITE
    set i_GPU_x, #1
    set i_GPU_y, #1
    set i_GPU_s, #1
    psh s_id_msg_request
    cal print_string
    add i_GPU_x, #144

    identification_loop:
        ;affichage des inputs
        set i_GPU_s, #1
        set i_GPU_x, #1
        set i_GPU_y, i_line
        
        ;check des entrees
        cpr s_input_sent, s_empty
        jpf password_id
        cal input_detector

        ;affichage des entrees
        psh s_input_buffer
        cal print_string

        jmp identification_loop
    id_checked:
    desktop_load:
    slp #100
    
    ;clear de l'ecran
    set i_GPU_color, i_CPU_SKYBLUE
    gpu clear

    ;AFFICHAGE ICONES===============
    ;konsole
    set i_GPU_x, #40
    set i_GPU_y, #40
    set i_GPU_w, #9
    set i_GPU_h, #14
    set i_GPU_map, m_console_logo
    set i_GPU_s, #4
    gpu drawmap

    ;settings
    set i_GPU_x, #140
    set i_GPU_y, #38
    set i_GPU_w, #11
    set i_GPU_h, #11
    set i_GPU_map, m_paraplegique_logo
    set i_GPU_s, #4
    gpu drawmap

    ;AFFICHAGE BOUTONS==============
    ;ligne 1===============
    ;bouton 1
    set i_GPU_s, #1
    set i_GPU_x, #30
    set i_GPU_y, #116
    psh s_desktop_console_word
    cal print_string

    ;bouton 2
    set i_GPU_x, #130
    psh s_settings_titre
    cal print_string

    ;bouton 3
    set i_GPU_x, #230
    psh s_desktop_empty
    cal print_string

    ;bouton 4
    set i_GPU_x, #330
    psh s_desktop_empty
    cal print_string

    ;bouton 5
    set i_GPU_x, #430
    psh s_desktop_empty
    cal print_string

    ;bouton 6
    set i_GPU_x, #530
    psh s_desktop_empty
    cal print_string

    ;ligne 2===============
    set i_GPU_x, #30

    ;bouton 7
    set i_GPU_s, #1
    add i_GPU_y, #120
    psh s_desktop_empty
    cal print_string

    ;bouton 8
    set i_GPU_x, #130
    psh s_desktop_empty
    cal print_string

    ;bouton 9
    set i_GPU_x, #230
    psh s_desktop_empty
    cal print_string

    ;bouton 10
    set i_GPU_x, #330
    psh s_desktop_empty
    cal print_string

    ;bouton 11
    set i_GPU_x, #430
    psh s_desktop_empty
    cal print_string

    ;bouton 12
    set i_GPU_x, #530
    psh s_desktop_empty
    cal print_string

    ;ligne 3===============
    set i_GPU_x, #30

    ;bouton 13
    set i_GPU_s, #1
    add i_GPU_y, #120
    psh s_desktop_empty
    cal print_string

    ;bouton 14
    set i_GPU_x, #130
    psh s_desktop_empty
    cal print_string

    ;bouton 15
    set i_GPU_x, #230
    psh s_desktop_empty
    cal print_string

    ;bouton 16
    set i_GPU_x, #330
    psh s_desktop_empty
    cal print_string

    ;bouton 17
    set i_GPU_x, #430
    psh s_desktop_empty
    cal print_string

    ;bouton 18
    set i_GPU_x, #530
    psh s_desktop_exit
    cal print_string

    ;initialisation carre de selection du desktop
    set i_GPU_x, #25
    set i_GPU_y, #111
    set i_GPU_w, #100
    set i_GPU_h, #20
    set i_GPU_t, #2
    gpu voidrect

    kernel_loop:
        ;detection des touches du tableau
        cpr b_IN_up, #1
        jpt desktop_up
        cpr b_IN_down, #1
        jpt desktop_down
        cpr b_IN_left, #1
        jpt desktop_left
        cpr b_IN_right, #1
        jpt desktop_right

        gpu voidrect ;affichage selection

        ;detection d'enter pour lancer application selectionnee
        cpr b_IN_enter, #1
        jpt desktop_application_launch

        jmp kernel_loop

;=====CONSOLE MAIN===============
console_launch:
    ;clear de l'ecran et preparation console
    set i_GPU_color, i_CPU_BLACK
    gpu clear
    set i_GPU_s, #1
    set i_GPU_x, #1
    set i_GPU_y, #1
    set i_line, #16
    set s_input_sent, s_empty
    
    ;hello de la console
    psh s_bluestar_welcome
    cal print_string
console:
    set s_arg, s_empty
    set i_parsed, #0
    cpr i_char, #0

    set i_GPU_s, #1
    set i_GPU_x, #1
    set i_GPU_y, i_line

    cpr s_input_sent, s_empty
    jpf interpret_input
    cal input_detector
    set i_GPU_color, i_CPU_WHITE

    psh s_input_buffer
    cal print_string

    cpr b_IN_maj, #1
    jpf console
    jmp desktop_load

========CONSOLE ROUTINES==================
    input_detector:
        ;alphabet
        cpr b_IN_a, #1
        jpt a_pressed
        cpr b_IN_b, #1
        jpt b_pressed
        cpr b_IN_c, #1
        jpt c_pressed
        cpr b_IN_d, #1
        jpt d_pressed
        cpr b_IN_e, #1
        jpt e_pressed
        cpr b_IN_f, #1
        jpt f_pressed
        cpr b_IN_g, #1
        jpt g_pressed
        cpr b_IN_h, #1
        jpt h_pressed
        cpr b_IN_i, #1
        jpt i_pressed
        cpr b_IN_j, #1
        jpt j_pressed
        cpr b_IN_k, #1
        jpt k_pressed
        cpr b_IN_l, #1
        jpt l_pressed
        cpr b_IN_m, #1
        jpt m_pressed
        cpr b_IN_n, #1
        jpt n_pressed
        cpr b_IN_o, #1
        jpt o_pressed
        cpr b_IN_p, #1
        jpt p_pressed
        cpr b_IN_q, #1
        jpt q_pressed
        cpr b_IN_r, #1
        jpt r_pressed
        cpr b_IN_s, #1
        jpt s_pressed
        cpr b_IN_t, #1
        jpt t_pressed
        cpr b_IN_u, #1
        jpt u_pressed
        cpr b_IN_v, #1
        jpt v_pressed
        cpr b_IN_w, #1
        jpt w_pressed
        cpr b_IN_x, #1
        jpt x_pressed
        cpr b_IN_y, #1
        jpt y_pressed
        cpr b_IN_z, #1
        jpt z_pressed

        ;nombres
        cpr b_IN_n1, #1
        jpt 1_pressed
        cpr b_IN_n2, #1
        jpt 2_pressed
        cpr b_IN_n3, #1
        jpt 3_pressed
        cpr b_IN_n4, #1
        jpt 4_pressed
        cpr b_IN_n5, #1
        jpt 5_pressed
        cpr b_IN_n6, #1
        jpt 6_pressed
        cpr b_IN_n7, #1
        jpt 7_pressed
        cpr b_IN_n8, #1
        jpt 8_pressed
        cpr b_IN_n9, #1
        jpt 9_pressed
        cpr b_IN_n0, #1
        jpt 0_pressed

        ;autre
        cpr b_IN_space, #1
        jpt space_pressed
        cpr b_IN_comma, #1
        jpt comma_pressed
        cpr b_IN_point, #1
        jpt point_pressed
        cpr b_IN_backspace, #1
        jpt backspace_pressed
        cpr b_IN_enter, #1
        jpt enter_pressed

        ret

    a_pressed:
        add s_input_buffer, s_a
        slp #90
        ret
    b_pressed:
        add s_input_buffer, s_b
        slp #90
        ret
    c_pressed:
        add s_input_buffer, s_c
        slp #90
        ret
    d_pressed:
        add s_input_buffer, s_d
        slp #90
        ret
    e_pressed:
        add s_input_buffer, s_e
        slp #90
        ret
    f_pressed:
        add s_input_buffer, s_f
        slp #90
        ret
    g_pressed:
        add s_input_buffer, s_g
        slp #90
        ret
    h_pressed:
        add s_input_buffer, s_h
        slp #90
        ret
    i_pressed:
        add s_input_buffer, s_i
        slp #90
        ret
    j_pressed:
        add s_input_buffer, s_j
        slp #90
        ret
    k_pressed:
        add s_input_buffer, s_k
        slp #90
        ret
    l_pressed:
        add s_input_buffer, s_l
        slp #90
        ret
    m_pressed:
        add s_input_buffer, s_m
        slp #90
        ret
    n_pressed:
        add s_input_buffer, s_n
        slp #90
        ret
    o_pressed:
        add s_input_buffer, s_o
        slp #90
        ret
    p_pressed:
        add s_input_buffer, s_p
        slp #90
        ret
    q_pressed:
        add s_input_buffer, s_q
        slp #90
        ret
    r_pressed:
        add s_input_buffer, s_r
        slp #90
        ret
    s_pressed:
        add s_input_buffer, s_s
        slp #90
        ret
    t_pressed:
        add s_input_buffer, s_t
        slp #90
        ret
    u_pressed:
        add s_input_buffer, s_u
        slp #90
        ret
    v_pressed:
        add s_input_buffer, s_v
        slp #90
        ret
    w_pressed:
        add s_input_buffer, s_w
        slp #90
        ret
    x_pressed:
        add s_input_buffer, s_x
        slp #90
        ret
    y_pressed:
        add s_input_buffer, s_y
        slp #90
        ret
    z_pressed:
        add s_input_buffer, s_z
        slp #90
        ret

    1_pressed:
        add s_input_buffer, s_1
        slp #90
        ret
    2_pressed:
        add s_input_buffer, s_2
        slp #90
        ret
    3_pressed:
        add s_input_buffer, s_3
        slp #90
        ret
    4_pressed:
        add s_input_buffer, s_4
        slp #90
        ret
    5_pressed:
        add s_input_buffer, s_5
        slp #90
        ret
    6_pressed:
        add s_input_buffer, s_6
        slp #90
        ret
    7_pressed:
        add s_input_buffer, s_7
        slp #90
        ret
    8_pressed:
        add s_input_buffer, s_8
        slp #90
        ret
    9_pressed:
        add s_input_buffer, s_9
        slp #90
        ret
    0_pressed:
        add s_input_buffer, s_0
        slp #90
        ret

    space_pressed:
        add s_input_buffer, s_space
        slp #90
        ret
    comma_pressed:
        add s_input_buffer, s_comma
        slp #90
        ret
    point_pressed:
        add s_input_buffer, s_point
        slp #90
        ret
    backspace_pressed:
        set i_GPU_x, #1
        set i_GPU_y, i_line
        set i_GPU_w, #480
        set i_GPU_h, #8
        set i_GPU_color, i_CPU_BLACK
        gpu rect
        set s_input_buffer, s_empty
        slp #90
        ret
    enter_pressed:
        set s_input_sent, s_input_buffer
        set s_input_buffer, s_empty
        add i_line, #16
        slp #90
        ret

    jmp console

interpret_input:
    set i_char_count, #0
    gtc i_instruction, s_input_sent, i_char_count

    ;instructions
    cpr i_instruction, #120
    jpt exit
    cpr i_instruction, #112
    jpt print
    cpr i_instruction, #114
    jpt read
    cpr i_instruction, #119
    jpt write

    jmp console

exit:                              ;quitte vers desktop
    set s_input_sent, s_empty
    set i_GPU_color, i_CPU_SKYBLUE
    gpu clear
    set i_line, #16
    jmp desktop_load

print:                             ;echo
    set i_char_count, #1
    cal arg_loop
    set i_GPU_color, i_CPU_WHITE
    psh s_arg
    cal print_string
    add i_line, #16
    set s_input_sent, s_empty
    jmp console

read:                              ;read a l'adresse
    set i_char_count, #1
    gtc i_char, s_input_sent, i_char_count
    cpr i_char, #115
    jpt string_read
    cpr i_char, #105
    jpt int_read
    cpr i_char, #98
    jpt bool_read
    set s_input_sent, s_empty
    jmp console

    string_read:
        set i_char_count, #2
        cal parse_loop
        rad s_return, i_parsed
        jmp after_read

    int_read:
        set i_char_count, #2
        cal parse_loop
        rad i_char, i_parsed
        its s_return, i_char
        jmp after_read

    bool_read:
        set i_char_count, #2
        cal parse_loop
        rad b_bool_read, i_parsed
        cpr b_bool_read, #0
        jpt read_bool_false
        cpr b_bool_read, #1
        jpt read_bool_true
        set s_input_sent, s_empty
        jmp console

        read_bool_false:
            set s_return, s_bool_false
            jmp after_read

        read_bool_true:
            set s_return, s_bool_true
            jmp after_read

    after_read:
        set i_GPU_color, i_CPU_WHITE
        psh s_return
        cal print_string
        add i_line, #16
        set s_input_sent, s_empty
        jmp console

write:                              ;ecrire a l'adresse
    set i_char_count, #2
    cal parse_w_space_loop
    cal arg_loop
    set i_char_count, #1
    gtc i_char, s_input_sent, i_char_count
    set i_adress, i_parsed
    cpr i_char, #115
    jpt string_write
    cpr i_char, #105
    jpt int_write
    cpr i_char, #98
    jpt bool_write
    set s_input_sent, s_empty
    jmp console
    
    string_write:
        wrt s_arg, i_adress
        jmp after_write
        
    int_write:
        set s_input_sent, s_arg
        set i_char_count, #-1
        set i_parsed, #0
        cal parse_loop
        wrt i_parsed, i_adress
        jmp after_write

    bool_write:
        cpr s_arg, s_0
        jpt bool_false
        cpr s_arg, s_1
        jpt bool_true
        set s_input_sent, s_empty
        jmp console

        bool_false:
            set b_bool_read, #0
            wrt b_bool_read, i_adress
            jmp after_write

        bool_true:
            set b_bool_read, #1
            wrt b_bool_read, i_adress
            jmp after_write


    after_write:
        its s_return, i_adress
        psh s_return
        cal print_string
        add i_line, #16
        set s_input_sent, s_empty
        jmp console

parse_loop:
    add i_char_count, #1
    gtc i_char, s_input_sent, i_char_count
    cpr i_char, #0
    jpt after_parse_loop
    sub i_char, #48
    mul i_parsed, #10
    add i_parsed, i_char
    jmp parse_loop

after_parse_loop:
    ret

parse_w_space_loop:
    add i_char_count, #1
    gtc i_char, s_input_sent, i_char_count
    cpr i_char, #32
    jpt after_parse_loop
    sub i_char, #48
    mul i_parsed, #10
    add i_parsed, i_char
    jmp parse_w_space_loop

after_parse_w_space_loop:
    ret

arg_loop:
    add i_char_count, #1
    gtc i_char, s_input_sent, i_char_count
    cal ascii_to_string
    cpr i_char, #0
    jpf arg_loop
    ret

ascii_to_string:
    cpr i_char, #0
    jpt char_null
    cpr i_char, #32
    jpt char_space
    cpr i_char, #44
    jpt char_comma
    cpr i_char, #46
    jpt char_point
    cpr i_char, #48
    jpt char_0
    cpr i_char, #49
    jpt char_1
    cpr i_char, #50
    jpt char_2
    cpr i_char, #51
    jpt char_3
    cpr i_char, #52
    jpt char_4
    cpr i_char, #53
    jpt char_5
    cpr i_char, #54
    jpt char_6
    cpr i_char, #55
    jpt char_7
    cpr i_char, #56
    jpt char_8
    cpr i_char, #57
    jpt char_9
    cpr i_char, #97
    jpt char_a
    cpr i_char, #98
    jpt char_b
    cpr i_char, #99
    jpt char_c
    cpr i_char, #100
    jpt char_d
    cpr i_char, #101
    jpt char_e
    cpr i_char, #102
    jpt char_f
    cpr i_char, #103
    jpt char_g
    cpr i_char, #104
    jpt char_h
    cpr i_char, #105
    jpt char_i
