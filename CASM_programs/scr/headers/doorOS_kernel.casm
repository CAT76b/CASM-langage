crt s_input_sent, ""
crt i_line, 16
crt i_instruction, 0
crt i_char_count, 0
crt s_return, ""
crt i_char, 0
crt s_arg, ""
crt i_parsed, 0
crt i_adress, 0
crt b_bool_read, 0
