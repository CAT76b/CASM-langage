;========PASSWORD ROUTINES========
password_id:
    ;check du mot de passe
    rad s_password, $0
    cpr s_input_sent, s_password
    jpt id_checked

    ;si mauvais mot de passe
    set s_input_sent, s_empty
    psh s_id_request_reject
    cal print_string
    slp 1000
    cal backspace_pressed
    jmp identification_loop

;========DESKTOP ROUTINES=========
desktop_application_launch:
    slp 100 ;anti_toogle

    cpr i_desktop_y, #1
    jpt app_launch_y1
    cpr i_desktop_y, #2
    jpt app_launch_y2
    jmp app_launch_y3
app_launch_y1:
    cpr i_desktop_x, #1
    jpt console_launch
    cpr i_desktop_x, #2
    jpt parametres_start
    cpr i_desktop_x, #3
    jpt kernel_loop
    cpr i_desktop_x, #4
    jpt kernel_loop
    cpr i_desktop_x, #5
    jpt kernel_loop
    jmp kernel_loop
app_launch_y2:
    cpr i_desktop_x, #1
    jpt kernel_loop
    cpr i_desktop_x, #2
    jpt kernel_loop
    cpr i_desktop_x, #3
    jpt kernel_loop
    cpr i_desktop_x, #4
    jpt kernel_loop
    cpr i_desktop_x, #5
    jpt kernel_loop
    jmp kernel_loop
app_launch_y3:
    cpr i_desktop_x, #1
    jpt kernel_loop
    cpr i_desktop_x, #2
    jpt kernel_loop
    cpr i_desktop_x, #3
    jpt kernel_loop
    cpr i_desktop_x, #4
    jpt kernel_loop
    cpr i_desktop_x, #5
    jpt kernel_loop

    ;procedure de dechargement du disque
    ;clear de l'ecran
    set i_GPU_color, i_CPU_BLACK
    gpu clear

    set s_input_sent, s_empty ;reinitialisation du mot de passe

    ;message d'information
    set i_GPU_x, #196
    set i_GPU_y, #236
    set i_GPU_s, #2
    psh s_return_boot_msg
    cal print_string
    slp 1500
    gpu clear
    jmp main

desktop_up:
    set i_GPU_color, i_CPU_SKYBLUE
    gpu voidrect
    set i_GPU_color, i_CPU_WHITE

    sub i_desktop_y, #1
    cpg i_desktop_y, #0
    jpt after_wrap_up
    add i_desktop_y, #3
    after_wrap_up:

    cal desktop_affichage
    slp 300
    jmp kernel_loop

desktop_down:
    set i_GPU_color, i_CPU_SKYBLUE
    gpu voidrect
    set i_GPU_color, i_CPU_WHITE

    add i_desktop_y, #1
    cpg i_desktop_y, #3
    jpf after_wrap_down
    sub i_desktop_y, #3
    after_wrap_down:

    cal desktop_affichage
    slp 300
    jmp kernel_loop

desktop_left:
    set i_GPU_color, i_CPU_SKYBLUE
    gpu voidrect
    set i_GPU_color, i_CPU_WHITE

    sub i_desktop_x, #1
    cpg i_desktop_x, #0
    jpt after_wrap_left
    add i_desktop_x, #6
    after_wrap_left:

    cal desktop_affichage
    slp 300
    jmp kernel_loop

desktop_right:
    set i_GPU_color, i_CPU_SKYBLUE
    gpu voidrect
    set i_GPU_color, i_CPU_WHITE

    add i_desktop_x, #1
    cpg i_desktop_x, #6
    jpf after_wrap_right
    sub i_desktop_x, #6
    after_wrap_right:

    cal desktop_affichage
    slp 300
    jmp kernel_loop

desktop_affichage:
    cpr i_desktop_y, #1
    jpt affichage_y1
    cpr i_desktop_y, #2
    jpt affichage_y2
    jmp affichage_y3
affichage_y1:
    cpr i_desktop_x, #1
    jpt affichage_x1y1
    cpr i_desktop_x, #2
    jpt affichage_x2y1
    cpr i_desktop_x, #3
    jpt affichage_x3y1
    cpr i_desktop_x, #4
    jpt affichage_x4y1
    cpr i_desktop_x, #5
    jpt affichage_x5y1
    set i_GPU_x, #525
    set i_GPU_y, #111
    ret
affichage_y2:
    cpr i_desktop_x, #1
    jpt affichage_x1y2
    cpr i_desktop_x, #2
    jpt affichage_x2y2
    cpr i_desktop_x, #3
    jpt affichage_x3y2
    cpr i_desktop_x, #4
    jpt affichage_x4y2
    cpr i_desktop_x, #5
    jpt affichage_x5y2
    set i_GPU_x, #525
    set i_GPU_y, #231
    ret
affichage_y3:
    cpr i_desktop_x, #1
    jpt affichage_x1y3
    cpr i_desktop_x, #2
    jpt affichage_x2y3
    cpr i_desktop_x, #3
    jpt affichage_x3y3
    cpr i_desktop_x, #4
    jpt affichage_x4y3
    cpr i_desktop_x, #5
    jpt affichage_x5y3
    set i_GPU_x, #525
    set i_GPU_y, #351
    ret

;premiere ligne
affichage_x1y1:
    set i_GPU_x, #25
    set i_GPU_y, #111
    ret
affichage_x2y1:
    set i_GPU_x, #125
    set i_GPU_y, #111
    ret
affichage_x3y1:
    set i_GPU_x, #225
    set i_GPU_y, #111
    ret
affichage_x4y1:
    set i_GPU_x, #325
    set i_GPU_y, #111
    ret
affichage_x5y1:
    set i_GPU_x, #425
    set i_GPU_y, #111
    ret

;deuxieme ligne
affichage_x1y2:
    set i_GPU_x, #25
    set i_GPU_y, #231
    ret
affichage_x2y2:
    set i_GPU_x, #125
    set i_GPU_y, #231
    ret
affichage_x3y2:
    set i_GPU_x, #225
    set i_GPU_y, #231
    ret
affichage_x4y2:
    set i_GPU_x, #325
    set i_GPU_y, #231
    ret
affichage_x5y2:
    set i_GPU_x, #425
    set i_GPU_y, #231
    ret

;troisieme ligne
affichage_x1y3:
    set i_GPU_x, #25
    set i_GPU_y, #351
    ret
affichage_x2y3:
    set i_GPU_x, #125
    set i_GPU_y, #351
    ret
affichage_x3y3:
    set i_GPU_x, #225
    set i_GPU_y, #351
    ret
affichage_x4y3:
    set i_GPU_x, #325
    set i_GPU_y, #351
    ret
affichage_x5y3:
    set i_GPU_x, #425
    set i_GPU_y, #351
    ret

;=====PARAPLEGIQUE ROUTINES============
parametres_start:
    ;reinitialisation de l'ecran
    set i_GPU_color, i_CPU_GRAY
    gpu clear
    set i_GPU_color, i_CPU_WHITE
    set i_GPU_s, #4

    ;affichage textes======
    set i_GPU_x, #191
    set i_GPU_y, #5
    psh s_settings_titre
    cal print_string
    set i_GPU_s, #2
    set i_GPU_x, #15

    ;texte 1 (ipf)
    set i_GPU_y, #50
    psh s_setting_text_1
    cal print_string
    set i_GPU_x, #15

    ;texte 2 (code)
    add i_GPU_y, #30
    psh s_setting_text_2
    cal print_string
    set i_GPU_x, #15

    ;exit
    set i_GPU_x, #15
    set i_GPU_y, #450
    psh s_desktop_exit
    cal print_string

    ;initialisation carre de selection
    set i_GPU_x, #10
    set i_GPU_y, #45
    set i_GPU_w, #280
    set i_GPU_h, #25
    set i_GPU_color, i_CPU_WHITE
    gpu voidrect

parametres:
    gpu voidrect ;actualisation de l'affichage du rectangle de selection

    ;detection touches de selection
    cpr b_IN_up, #1
    jpt params_up
    cpr b_IN_down, #1
    jpt params_down

    ;detection touche enter
    cpr b_IN_enter, #1
    jpt parametres_modifs
    jmp parametres

    params_up:
        ;effacage ancien rect
        set i_GPU_color, i_CPU_GRAY
        gpu voidrect
        set i_GPU_color, i_CPU_WHITE
        slp #300

        ;modification ordonnee
        sub i_parametres_y, #1
        cpg i_parametres_y, #0
        jpt parametres_affichage_actualisation
        add i_parametres_y, #3
        jmp parametres_affichage_actualisation
    params_down:
        ;effacage ancien rect
        set i_GPU_color, i_CPU_GRAY
        gpu voidrect
        set i_GPU_color, i_CPU_WHITE
        slp #300

        ;modification ordonnee
        add i_parametres_y, #1
        cpg i_parametres_y, #3
        jpf parametres_affichage_actualisation
        sub i_parametres_y, #3
        jmp parametres_affichage_actualisation
    parametres_affichage_actualisation:
        cpr i_parametres_y, #1
        jpt params_affichage_y1
        cpr i_parametres_y, #2
        jpt params_affichage_y2
        cpr i_parametres_y, #3
        jpt params_affichage_y5 ;5 pour pouvoir accueillir plus d'options plus tard
    params_affichage_y1:
        set i_GPU_y, #45
        jmp parametres
    params_affichage_y2:
        set i_GPU_y, #75
        jmp parametres
    params_affichage_y5:
        set i_GPU_y, #445
        jmp parametres

    parametres_modifs:
        cpr i_parametres_y, #1
        jpt parametres_ipf_initialisation
        cpr i_parametres_y, #2
        jpt parametres_code_initialisation
        jmp desktop_load
        
    ;parametres de changement d'ipf
    parametres_ipf_initialisation:
        ;clear de l'ecran
        set i_GPU_color, i_CPU_GRAY
        gpu clear
        set i_GPU_color, i_CPU_WHITE
        set i_GPU_y, #20

        ;bouton 1================
        set i_GPU_x, #25
        psh s_params_bouton1
        cal print_string

        ;bouton 2================
        set i_GPU_x, 125
        psh s_params_bouton2
        cal print_string

        ;bouton 3================
        set i_GPU_x, #225
        psh s_params_bouton3
        cal print_string

        ;information text========
        set i_GPU_x, #35
        set i_GPU_y, #50
        psh s_params_ipf_text
        cal print_string

        ;rectangle de selection==
        set i_GPU_x, #20
        set i_GPU_y, #15
        set i_GPU_w, #100
        set i_GPU_h, #30
        set i_GPU_color, i_CPU_WHITE
        gpu voidrect

    parametres_ipf:
        gpu voidrect ;actualisation du rectangle de selection

        ;detection des touches de selection
        cpr b_IN_left, #1
        jpt params_ipf_left
        cpr b_IN_right, #1
        jpt params_ipf_right

        ;detection touche enter
        cpr b_IN_enter, #1
        jpt params_ipf_select

        ;detection touche maj (quit)
        cpr b_IN_maj, #1
        jpt parametres
        cpr i_parametres_x, #1
        jpt params_ipf_x1
        cpr i_parametres_x, #2
        jpt params_ipf_x2
        cpr i_parametres_x, #3
        jpt params_ipf_x3
        set i_GPU_x, #70
        jmp parametres_ipf
    params_ipf_select:
        cpr i_parametres_x, #1
        jpt params_ifp_selected1
        cpr i_parametres_x, #2
        jpt params_ifp_selected2
        cpr i_parametres_x, #3
        jpt params_ifp_selected3
        ipf 1800          ;option 4
        jmp parametres
    params_ifp_selected1:
        ipf 1             ;option 1 (troll)
        jmp parametres
    params_ifp_selected2:
        ipf 800           ;option 2
        jmp parametres
    params_ifp_selected3:
        ipf 1200          ;option 3
        jmp parametres
    params_ipf_left:
        ;effacage de lancien rect
        set i_GPU_color, i_CPU_GRAY
        gpu voidrect
        set i_GPU_color, i_CPU_WHITE
        slp #100

        ;modification abscisse
        sub i_parametres_x, #1
        cpg i_parametres_x, #0
        jpt parametres
        add i_parametres_x, #4
        jmp parametres
    params_ipf_right:
        ;effacage de lancien rect
        set i_GPU_color, i_CPU_GRAY
        gpu voidrect
        set i_GPU_color, i_CPU_WHITE
        slp #100

        ;modification abscisse
        add i_parametres_x, #1
        cpg i_parametres_x, #0
        jpf parametres
        sub i_parametres_x, #4
        jmp parametres
    params_ipf_x1:
        set i_GPU_x, #20
        jmp parametres_ipf
    params_ipf_x2:
        set i_GPU_x, #100
        jmp parametres_ipf
    params_ipf_x3:
        set i_GPU_x, #200
        jmp parametres_ipf
    
    ;parametres de changement de code
    parametres_code_initialisation:
        ;clear de l'ecran
        set i_GPU_color, i_CPU_BLACK
        gpu clear

        set s_input_sent, s_empty   ;reinitialisation du sent
        set s_input_buffer, s_empty ;reinitialisation du buffer
        set i_line, #16

        ;position d'affichage
        set i_GPU_color, i_CPU_WHITE
        set i_GPU_x, #1
        set i_GPU_y, #1
        set i_GPU_s, #1
        psh s_new_password_welcome
        cal print_string

    parametres_code:
        set i_GPU_s, #1
        set i_GPU_x, #1
        set i_GPU_y, i_line
        
        ;check des entrees
        cpr s_input_sent, s_empty
        jpf params_new_code
        cal input_detector
        set i_GPU_color, i_CPU_WHITE

        ;affichage des entrees
        psh s_input_buffer
        cal print_string

        jmp parametres_code
    params_new_code:
        ;verification des tentatives de leave parametres de code
        cpr s_input_sent, s_x
        jpt parametres_start
        cpr s_input_sent, s_desktop_exit
        jpt parametres_start

        rad s_password, $0 ;lecture de l'ancien password

        ;compare ancien avec nouveau password
        cpr s_input_sent, s_password
        jpf new_password_check
        psh s_id_request_reject
        cal print_string
        slp #1000
        cal backspace_pressed
        jmp parametres_code
        new_password_check:

        wrt s_input_sent, $0 ;ecriture new password
        jmp parametres

;==========DEATH NOTE TEXT EDITOR=================
text_editor_start:
    set i_GPU_color, i_CPU_BLACK
    gpu clear

    set s_input_buffer, s_empty
    set s_input_sent, s_empty

    set i_line, #16

    set b_gave_adress, #0

    set i_GPU_color, i_CPU_WHITE
    set i_GPU_x, #1
    set i_GPU_y, #1
    set i_GPU_s, #1
    psh s_death_note_welcome
    cal print_string

text_editor_loop:
    set i_GPU_s, #1
    set i_GPU_x, #1
    set i_GPU_y, i_line
    set i_parsed, #0

    cpr s_input_sent, s_empty
    jpf text_read_line
    cal input_detector
    set i_GPU_color, i_CPU_WHITE

    psh s_input_buffer
    cal print_string

    cpr b_IN_maj, #1
    jpf text_editor_loop
    jmp desktop_load

    text_read_line:
        cpr b_gave_adress, #1
        jpt text_write_line
        set i_char_count, #-1
        cal parse_loop
        set i_mem_line, i_parsed
        set s_input_sent, s_empty
        set b_gave_adress, #1
        jmp text_editor_loop

    text_write_line:
        wrt s_input_sent, i_mem_line
        set s_input_sent, s_empty
        add i_mem_line, #2
        jmp text_editor_loop

