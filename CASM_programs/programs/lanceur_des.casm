section.data
crt s_reponse, ""
crt s_yes, "y"
crt s_no, "n"
crt i_i, 3
crt i_loop, 0
crt i_result, 0
crt i_reset, 0

section.code
main:
    prt "Bonjour!\n"
start:
    prt "Lancer[y/n]?:"
    lct s_reponse
    cpr s_reponse, s_yes
    jpt lancer_des
    cpr s_reponse, s_no
    jpt end
    jmp error

end:
    prt "Aurevoir!"
    ext

lancer_des:
    rnd i_result, 7
    add i_result, 1
    prt "Le de roule"
point_loop:
    slp 300
    prt "."
    add i_loop, 1
    cpg i_loop, i_i
    jpf point_loop
    prt "\n"
    prt i_result
    prt "\n"
    set i_loop, i_reset
    jmp start

error:
    prt "Erreur: veuillez entrer \"y\" ou \"n\"\n"
    jmp start

ext ;securite
;magnus carlsen 2024-06
