header "GPU_2d_registers.casm"

section.data
crt i_time_start, 0
crt i_time_current, 0
crt i_time_elapsed, 0
crt i_temp, 0

section.code
main:
    ;dessine un rectangle rouge
    set i_GPU_x, 20
    set i_GPU_y, 10
    set i_GPU_w, 30
    set i_GPU_h, 45
    set i_GPU_color, i_CPU_RED
    gpu rect
    slp 5000

ext ;securite