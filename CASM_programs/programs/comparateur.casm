section.data
    crt i_a, 0
    crt i_b, 0
    crt s_reponse, ""
    crt s_yes, "y"
    crt s_no, "n"

section.code
prt "bonjour!\n"
jmp lancement
main:
    prt "entrez un nombre:"
    lct i_a
    prt "\nentrez un second nombre:"
    lct i_b
    cpr i_a, i_b
    jpt egal
    cpg i_a, i_b
    jpt greater
    jpf less

end:
    prt "aurevoir!"
    ext

;si les nombres sont egaux
egal:
    prt "\n"
    prt i_a
    prt " et "
    prt i_b
    prt " sont egaux\n"
    jmp lancement

;si le premier nombre est plus grand
greater:
    prt "\n"
    prt i_a
    prt " est plus grand que "
    prt i_b
    prt "\n"
    jmp lancement

;si le deuxieme nombre est plus grand
less:
    prt "\n"
    prt i_a
    prt " est plus petit que "
    prt i_b
    prt "\n"

lancement:
    prt "lancer[y/n]?:"
    lct s_reponse
    cpr s_reponse, s_yes
    jpt main
    cpr s_reponse, s_no
    jpt end
    prt "erreur:entree invalide:"
    prt s_reponse
    prt "\n"
    jmp lancement

ext ;securite
