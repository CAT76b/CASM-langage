    jpt z
    cpr i_genere, 52
    jpt n1
    cpr i_genere, 53
    jpt n2
    cpr i_genere, 54
    jpt n3
    cpr i_genere, 55
    jpt n4
    cpr i_genere, 56
    jpt n5
    cpr i_genere, 57
    jpt n6
    cpr i_genere, 58
    jpt n7
    cpr i_genere, 59
    jpt n8
    cpr i_genere, 60
    jpt n9
    cpr i_genere, 61
    jpt n0

loop_exit:
    ret

;ajout du caractere
