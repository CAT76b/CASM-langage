section.data
crt s_lancer, ""
crt s_yes, "y"
crt s_no, "n"
crt i_iterations, 0
crt i_longueur, 0
crt i_genere, 0
crt s_code, ""
crt s_empty, ""
crt i_loop, 0
crt i_zero, 0
crt i_loop2, 0
crt s_A, "A"
crt s_B, "B"
crt s_C, "C"
crt s_D, "D"
crt s_E, "E"
crt s_F, "F"
crt s_G, "G"
crt s_H, "H"
