crt s_n2, "2"
crt s_n3, "3"
crt s_n4, "4"
crt s_n5, "5"
crt s_n6, "6"
crt s_n7, "7"
crt s_n8, "8"
crt s_n9, "9"
crt s_n0, "0"

section.code
main:
    prt "Bonjour!\n"
start:
    prt "Lancer[y/n]?:"
    lct s_lancer
    cpr s_lancer, s_yes
    jpt principal
    cpr s_lancer, s_no
    jpt end
    jmp error
    
principal:
    set i_loop, i_zero
    set i_loop2, i_zero
    set i_genere, i_zero

    prt "Combien d'iterations?:"
    lct i_iterations
    prt "Quelle longueur?:"
    lct i_longueur
    add i_longueur, 1
    cpr i_iterations, 0
    jpt error2
    cpr i_longueur, 0
    jpt error3
    cpr i_loop2, i_iterations
    jpt start

generate_loop:
    add i_loop2, 1
    set i_loop, i_zero
    set s_code, s_empty

    cal generation
    prt "Code numero "
    prt i_loop2
    prt ": "
    prt s_code
    prt "\n"

    cpr i_loop2, i_iterations
    jpf generate_loop
    jmp start

error:
    prt "Erreur: entree invalide =>"
    prt s_lancer
    prt "\n"
    jmp start
error2:
    prt "Erreur: nombre d'iterations doit etre superieur a 0\n"
    jmp start
error3:
    prt "Erreur: la longueur doit etre superieur a 0\n"
    jmp start

end:
    prt "Aurevoir!\n"
    ext

generation:
loop:
    ;gestion des boucles
    add i_loop, 1
    cpr i_loop, i_longueur
    jpt loop_exit
    
    rnd i_genere, 62

    ;selection du caractere a ajouter
    cpr i_genere, 0
    jpt A
    cpr i_genere, 1
    jpt B
    cpr i_genere, 2
    jpt C
    cpr i_genere, 3
    jpt D
    cpr i_genere, 4
    jpt E
    cpr i_genere, 5
    jpt F
    cpr i_genere, 6
    jpt G
    cpr i_genere, 7
    jpt H
    cpr i_genere, 8
    jpt I
    cpr i_genere, 9
    jpt J
    cpr i_genere, 10
    jpt K
    cpr i_genere, 11
    jpt L
    cpr i_genere, 12
    jpt M
    cpr i_genere, 13
    jpt N
    cpr i_genere, 14
    jpt O
    cpr i_genere, 15
    jpt P
    cpr i_genere, 16
    jpt Q
    cpr i_genere, 17
    jpt R
    cpr i_genere, 18
    jpt S
    cpr i_genere, 19
    jpt T
    cpr i_genere, 20
    jpt U
    cpr i_genere, 21
    jpt V
    cpr i_genere, 22
    jpt W
    cpr i_genere, 23
    jpt X
    cpr i_genere, 24
    jpt Y
